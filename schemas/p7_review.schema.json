{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Step 7: Review findings against rubric",
  "type": "object",
  "required": ["findings", "outside_rubric"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "path", "line_start", "line_end", "comment", "confidence"],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 0
          },
          "line_end": {
            "type": "integer",
            "minimum": 0
          },
          "comment": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "outside_rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "line_start", "note"],
        "properties": {
          "path": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
