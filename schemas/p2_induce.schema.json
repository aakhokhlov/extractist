{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Step 2: Induce rules from claims",
  "type": "object",
  "required": ["rules", "singletons"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "axis",
          "scope",
          "applies_to",
          "evidence_thread_ids",
          "best_evidence_claim_id",
          "counterexample",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "axis": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": ["universal", "local_taste"]
          },
          "applies_to": {
            "type": ["string", "null"]
          },
          "evidence_thread_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "best_evidence_claim_id": {
            "type": "string"
          },
          "counterexample": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "singletons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread_ids", "note"],
        "properties": {
          "thread_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
